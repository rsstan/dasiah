# Web container of the `full` profile: the built frontend and /api proxied to the gateway.
# SITE_ADDRESS: ":80" (default, plain HTTP) or a domain, for which Caddy obtains a TLS
# certificate automatically and redirects HTTP to HTTPS.
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$GATEWAY_UPSTREAM:gateway:8080}
	}

	# Readiness of the gateway and every service behind it (JSON), for a quick look.
	handle /health {
		rewrite * /health/ready
		reverse_proxy {$GATEWAY_UPSTREAM:gateway:8080}
	}

	handle {
		root * /srv
		# Hashed assets never change; the page itself is always revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
}

# For the container's health check only (not published): independent of SITE_ADDRESS, because with a
# domain port 80 redirects to HTTPS, which has no certificate for 127.0.0.1.
http://127.0.0.1:2020 {
	bind 127.0.0.1
	root * /srv
	file_server
}
