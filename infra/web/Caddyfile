# Web container of the `full` profile: the built frontend and /api proxied to the gateway.
# Production (phase 10) adds the domain and TLS.
{
	admin off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$GATEWAY_UPSTREAM:gateway:8080}
	}

	handle {
		root * /srv
		# Hashed assets never change; the page itself is always revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
}
