{
  "extends": "./tsconfig.base.json",
  "include": [
    "apps/*/src",
    "apps/*/test",
    "services/*/src",
    "services/*/test",
    "packages/*/src",
    "packages/*/test",
    "packages/*/examples",
    "tests/*/src",
    "tests/*/*.config.ts",
    "scripts/**/*.ts",
    "db/**/*.ts",
    "contracts/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["**/node_modules", "apps/web"]
}
