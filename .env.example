# Copy to .env and fill in. Secrets stay empty here: never commit real values.
# Non-secret entries show local defaults.

# --- PostgreSQL (compose) ---
POSTGRES_DB=heatmap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
PG_HOST=localhost
PG_PORT=5432

# Login role passwords, applied by scripts/db-set-passwords.sh (SCRAM-SHA-256)
DB_PASSWORD_APP_ADMIN=
DB_PASSWORD_SVC_IDENTITY=
DB_PASSWORD_SVC_TRANSIT=
DB_PASSWORD_SVC_ACCESSIBILITY=
DB_PASSWORD_SVC_PLACES=
DB_PASSWORD_REPORTING=

# --- RabbitMQ ---
# Services use AMQP_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@localhost:<AMQP_PORT>
AMQP_URL=
RABBITMQ_USER=heatmap
RABBITMQ_PASSWORD=
AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Redis (gateway rate limits) ---
REDIS_PORT=6379

# --- Tracing ---
JAEGER_UI_PORT=16686
OTLP_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Common service settings ---
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000

# --- test seed (pnpm db:seed:test): password of the demo accounts; random if empty ---
SEED_DEMO_PASSWORD=

# --- identity ---
# Ed25519 key, PKCS#8 PEM on one line with \n escapes:
#   openssl genpkey -algorithm ed25519 | sed -z 's/\n$//; s/\n/\\n/g'
JWT_PRIVATE_KEY=
JWT_KEY_ID=
ACCESS_TTL_S=900
REFRESH_TTL_S=2592000
COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_WINDOW_S=900

# --- gateway ---
WEB_ORIGIN=http://localhost:5173
UPSTREAM_TIMEOUT_MS=10000
ACCESSIBILITY_TIMEOUT_MS=60000
TRUST_PROXY=false

# --- accessibility ---
OSRM_URL_WAW=http://localhost:5001
OSRM_URL_VNO=http://localhost:5002
ALGO_VERSION=1
MAX_PARALLEL_CALCS=
CAR_TIME_FACTOR=
CAR_OVERHEAD_S=

# --- places ---
GEOCODER_PROVIDER=photon
GEOCODER_URL=https://photon.komoot.io
GEOCODER_MIN_INTERVAL_MS=1000

# --- transit-data ---
STORAGE_DRIVER=fs
STORAGE_PATH=./data/storage
S3_BUCKET=

# ---- Compose profile `full` (services in containers): optional replacements of the stand-ins
# OSRM per city: own (infra/osrm/build.sh <city>, profile osrm), e.g. http://osrm-vno:5000, or
# the public demo server https://router.project-osrm.org (then CONTAINER_OSRM_PARALLEL=1 and
# CONTAINER_OSRM_MIN_INTERVAL_MS=1000, its usage policy); empty = straight-line stand-in.
CONTAINER_OSRM_URL_WAW=
CONTAINER_OSRM_URL_VNO=
CONTAINER_OSRM_PARALLEL=
CONTAINER_OSRM_MIN_INTERVAL_MS=
# Photon-compatible geocoder, e.g. https://photon.komoot.io; empty = testville stand-in.
CONTAINER_GEOCODER_URL=
CONTAINER_GEOCODER_MIN_INTERVAL_MS=
