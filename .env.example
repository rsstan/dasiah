# Copy to .env and fill in. Secrets stay empty here: never commit real values.
# Non-secret entries show local defaults.

# --- PostgreSQL (compose) ---
POSTGRES_DB=heatmap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
PG_HOST=localhost
PG_PORT=5432

# Login role passwords, applied by scripts/db-set-passwords.sh (SCRAM-SHA-256)
DB_PASSWORD_APP_ADMIN=
DB_PASSWORD_SVC_IDENTITY=
DB_PASSWORD_SVC_TRANSIT=
DB_PASSWORD_SVC_ACCESSIBILITY=
DB_PASSWORD_SVC_PLACES=
DB_PASSWORD_REPORTING=

# --- RabbitMQ ---
RABBITMQ_USER=heatmap
RABBITMQ_PASSWORD=
AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Redis (gateway rate limits) ---
REDIS_PORT=6379

# --- Tracing ---
JAEGER_UI_PORT=16686
OTLP_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Common service settings ---
LOG_LEVEL=info

# --- identity ---
JWT_PRIVATE_KEY=
JWT_KEY_ID=
ACCESS_TTL_S=900
REFRESH_TTL_S=2592000

# --- gateway ---
WEB_ORIGIN=http://localhost:5173

# --- accessibility ---
OSRM_URL_WAW=http://localhost:5001
OSRM_URL_VNO=http://localhost:5002
ALGO_VERSION=1
MAX_PARALLEL_CALCS=
CAR_TIME_FACTOR=
CAR_OVERHEAD_S=

# --- places ---
GEOCODER_PROVIDER=photon
GEOCODER_URL=https://photon.komoot.io
GEOCODER_MIN_INTERVAL_MS=1000

# --- transit-data ---
STORAGE_DRIVER=fs
STORAGE_PATH=./data/storage
S3_BUCKET=
