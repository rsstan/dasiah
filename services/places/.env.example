# Service-local settings for `pnpm --filter @heatmap/places dev` (the root .env is read first).
SERVICE_NAME=places
PORT=3004
# postgres://svc_<role>:<DB_PASSWORD_SVC_ROLE>@localhost:<PG_PORT>/heatmap
DATABASE_URL=
# amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@localhost:<AMQP_PORT>
AMQP_URL=
# transit-data base URL (city list and bounding boxes), e.g. http://localhost:<TRANSIT_PORT>
TRANSIT_URL=
# photon (default) or nominatim; URL of the chosen instance (respect its usage policy)
GEOCODER_PROVIDER=
GEOCODER_URL=
