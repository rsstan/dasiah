{
  "name": "@heatmap/accessibility",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Accessibility maps: RAPTOR transit times, OSRM car times, ratio per H3 cell",
  "scripts": {
    "start": "node --import @heatmap/common/otel src/main.ts",
