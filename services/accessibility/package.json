  },
  "dependencies": {
    "@heatmap/common": "workspace:*",
    "@heatmap/contracts": "workspace:*",
    "cockatiel": "4.0.0",
    "h3-js": "4.5.0",
    "kysely": "0.29.9",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@heatmap/testing": "workspace:*",
    "fastify": "5.12.8"
  }
}
