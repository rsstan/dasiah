{
  "name": "transit-heatmap",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "compose": "scripts/with-env.sh docker compose --env-file .env -f infra/compose/docker-compose.yml",
    "infra:up": "pnpm -s compose --profile infra up -d --wait",
    "infra:down": "pnpm -s compose --profile infra down",
    "db:passwords": "DB_TOOL=scripts/db-set-passwords.sh scripts/with-env.sh scripts/db-as.sh superuser",
    "db:reset": "scripts/with-env.sh scripts/db-reset.sh",
    "db:bootstrap": "scripts/with-env.sh scripts/db-bootstrap.sh",
    "db:migrate": "scripts/with-env.sh node db/tools/migrate.ts",
    "db:seed": "scripts/with-env.sh scripts/db-seed.sh",
    "db:seed:test": "scripts/with-env.sh node db/seed/test/seed.ts",
    "db:smoke": "scripts/with-env.sh scripts/db-as.sh superuser -q -v ON_ERROR_STOP=1 -f db/tests/smoke.sql",
    "db:dict": "DB_TOOL=scripts/gen-data-dictionary.sh scripts/with-env.sh scripts/db-as.sh app_admin",
    "db:backup": "scripts/with-env.sh scripts/db-backup.sh",
    "db:restore": "scripts/with-env.sh scripts/db-restore.sh",
    "db:plans": "scripts/with-env.sh scripts/db-as.sh superuser -q -f db/tests/query-plans.sql > docs/db/query-plans.md",
    "db:diagrams": "node db/tools/export-diagrams.ts",
    "db:psql": "scripts/with-env.sh scripts/db-as.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mermaid-js/mermaid-cli": "12.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "h3-js": "4.5.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
