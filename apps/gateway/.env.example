# Gateway-local settings for `pnpm --filter @heatmap/gateway dev` (the root .env is read first).
SERVICE_NAME=gateway
PORT=8080
IDENTITY_URL=http://localhost:3001
TRANSIT_URL=http://localhost:3002
ACCESSIBILITY_URL=http://localhost:3003
PLACES_URL=http://localhost:3004
# redis://localhost:<REDIS_PORT>
REDIS_URL=redis://localhost:6379
