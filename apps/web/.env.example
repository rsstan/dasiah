# Optional overrides for `pnpm --filter @heatmap/web dev`.
# Gateway the dev server proxies /api to (default http://localhost:8080).
GATEWAY_URL=
# MapLibre style URL of the basemap (default: OpenFreeMap Positron). Its sources must carry the
# OpenStreetMap attribution, which the map shows (ODbL).
VITE_MAP_STYLE_URL=
# Basemap of the dark theme (default: OpenFreeMap Dark).
VITE_MAP_STYLE_URL_DARK=
