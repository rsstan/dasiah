{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": { "configFile": "vitest.mutation.config.ts", "related": true },
  "mutate": [
    "services/accessibility/src/raptor/raptor.ts",
    "services/accessibility/src/calculation/cells.ts",
    "services/accessibility/src/calculation/request.ts",
    "services/transit-data/src/timetable/patterns.ts",
    "services/identity/src/domain/password.ts",
    "services/identity/src/domain/tokens.ts",
    "services/places/src/geocoding/geocoder.ts",
    "apps/gateway/src/auth.ts",
    "packages/common/src/geo.ts"
  ],
  "ignorePatterns": [
    "data",
    "coverage",
    "docs",
    "infra",
    "apps/web/dist",
    "tests/e2e",
    ".e2e",
    ".lighthouse",
    "backups",
    "reports"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "clearTextReporter": { "allowColor": false, "logTests": false, "reportTests": false },
  "thresholds": { "high": 90, "low": 85, "break": 85 },
  "timeoutMS": 60000,
  "concurrency": 4,
  "tempDirName": ".stryker-tmp"
}
